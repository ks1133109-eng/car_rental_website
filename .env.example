# ─────────────────────────────────────────────────────────────────
# DriveX — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git.
# ─────────────────────────────────────────────────────────────────

# ── Core Flask ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string-min-32-chars

# ── Database ──────────────────────────────────────────────────────
# Leave blank to use SQLite locally (drivex.db)
# For Supabase/Render: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Admin Credentials (used by /reset-db seed) ────────────────────
ADMIN_EMAIL=your-admin-email@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=replace-with-secure-password

# ── /reset-db Protection Token ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
# Usage: visit /reset-db?token=YOUR_TOKEN_HERE
RESET_DB_TOKEN=replace-with-long-random-token

# ── Cloudinary (Image CDN) ────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay (Payments) ───────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Email (Resend) ────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Render.com Deployment ─────────────────────────────────────────
# Render automatically sets this. Do NOT set it locally.
# RENDER=true
